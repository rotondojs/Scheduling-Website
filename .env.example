# Copy this file to server/.env and fill in your values

# Port for the Express server (default: 3000)
PORT=3000

# MongoDB connection string (optional — omit to use in-memory storage)
# MONGO_URI=mongodb://localhost:27017/gameschedule

# --- Game Stats API Keys ---

# Fortnite (optional — works without a key, key gives higher rate limits)
# Get one free at https://fortnite-api.com
# FORTNITE_API_KEY=

# Steam (required for Steam tab)
# Get a free key at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# Apex Legends (required for Apex tab)
# Get a free key at https://apexlegendsapi.com
# APEX_API_KEY=
